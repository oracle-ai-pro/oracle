{
  "name": "Core Node 2.6 PRO",
  "short_name": "Core Node",
  "description": "Prestige HQ — чаты, Reader, Split View, API, лимиты. Работает офлайн как PWA.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "window-controls-overlay",
    "standalone",
    "minimal-ui"
  ],
  "orientation": "any",
  "background_color": "#0a0b10",
